# Kumbh Smart Seva Environment Variables
# Copy this to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database Configuration
# For local development: database/main.db
# For Render deployment: /tmp/main.db or use PostgreSQL
DATABASE_PATH=database/main.db

# Google Generative AI (Optional - for translation feature)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Add other configuration variables as needed
